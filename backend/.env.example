# Copy this file to ".env" and fill in your values. Never commit ".env" to GitHub.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# If your password has special characters, URL-encode them (for example @ becomes %40)
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/dev_team
MAX_FIX_ATTEMPTS=3

# --- only needed for a public deployment (leave empty locally) ---
ACCESS_CODE=
MAX_CONCURRENT_RUNS=2
MAX_PROJECTS_PER_DAY=20
CORS_ORIGINS=http://localhost:5173
